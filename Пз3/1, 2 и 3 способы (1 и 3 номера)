4 способ

#include <iostream>
using namespace std;
//1
class Geometry {
public:
    static double hypotenuse(double a, double b) {
        return sqrt(a*a + b*b);
    }
};

//3
class NumberUtils {
public:
    static int tensDigit(int n) {
        return (n / 10) % 10;
    }
};

int main() {
    double a, b, number; 
    cin >> a >> b;
    cout << Geometry::hypotenuse(a, b) << endl; 
    cin >> number;
    cout << NumberUtils::tensDigit(number) << endl;
}

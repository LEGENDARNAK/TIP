#include <iostream>
using namespace std;
int main() {
    double number, res_n = 1, resultat = 1;
    cout << "введите любое число:";
    cin >> number;
    for (int i = 1; i <= number; i++) {
        res_n = res_n * i;
        resultat = resultat * res_n;
    }
    cout << resultat;
    return 0;
}

